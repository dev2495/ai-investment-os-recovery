AI_OS_POSTGRES_USER=ai_os
AI_OS_POSTGRES_PASSWORD=ai_os_local_dev_change_me
AI_OS_POSTGRES_DB=ai_os
AI_OS_POSTGRES_PORT=54329

AI_OS_QDRANT_HTTP_PORT=6333
AI_OS_QDRANT_GRPC_PORT=6334

AI_OS_REDIS_PORT=63799

# Local model routing. Keep provider keys outside this file.
AI_OS_DEFAULT_MODEL_PROVIDER=ollama
AI_OS_DEFAULT_MODEL=qwen3:8b
AI_OS_STRONG_MODEL_PROVIDER=local_or_cloud
AI_OS_STRONG_MODEL=

# Vault/runtime paths. Runtime data should stay on the external SSD.
AI_OS_VAULT_PATH=/Volumes/Devarsh SSD/Obsidian memory 
AI_OS_RUNTIME_PATH=/Volumes/Devarsh SSD/Obsidian memory /_ai_os_runtime
