AI_OS_NODE_ROLE=imac_backend
AI_OS_SSD_ROOT='/Volumes/Devarsh SSD'
AI_OS_DATA_ROOT='/Volumes/Devarsh SSD/AI OS Data'
AI_OS_VAULT_ROOT='/Volumes/Devarsh SSD/Obsidian memory '
AI_OS_IMAC_RUNTIME_DATA='/Volumes/Devarsh SSD/AI OS Data/imac-runtime'
# Runtime model catalogs stay internal because removable-volume I/O can interrupt long-lived model servers.
AI_OS_OLLAMA_MODELS='__HOME__/AI_OS_NODE/model-cache/ollama/models'
AI_OS_COLIMA_HOME='/Volumes/Devarsh SSD/AI OS Data/colima'
AI_OS_REPO_ROOT='__REPO_ROOT__'
AI_OS_RUNTIME_LOG_ROOT='__HOME__/Library/Logs/AIOS/runtime'
AI_OS_RUNTIME_RUN_ROOT='__HOME__/Library/Application Support/AIOS/run'
AI_OS_POSTGRES_USER=ai_os
AI_OS_POSTGRES_PASSWORD='__GENERATED__'
AI_OS_POSTGRES_DB=ai_os
AI_OS_POSTGRES_PORT=54329
AI_OS_QDRANT_HTTP_PORT=6333
AI_OS_QDRANT_GRPC_PORT=6334
AI_OS_REDIS_PORT=63799
# Zerodha API key and secret are provisioned in the private runtime env or Keychain, never committed.
AI_OS_ZERODHA_EXPECTED_USER_ID=''
AI_OS_ZERODHA_AUTH_CHALLENGE_TTL_SECONDS=300
AI_OS_API_PORT=8765
AI_OS_UI_PORT=5177
AI_OS_OLLAMA_PORT=11434
AI_OS_EMBEDDING_MODEL='qwen3-embedding:0.6b'
AI_OS_ENABLE_NANBEIGE42=1
AI_OS_NANBEIGE_PORT=11436
# Canonical model artifacts belong on the SSD; the supervised runtime uses this internal read cache.
AI_OS_NANBEIGE_ROOT='__HOME__/AI_OS_NODE/model-cache/nanbeige42'
AI_OS_NANBEIGE_RUNTIME_ROOT='__HOME__/AI_OS_NODE/model-runtimes/nanbeige42/c6640a1c0cf7b38df342b67021a3900b04d092e7'
AI_OS_OPENAI_URL='https://api.openai.com/v1'
AI_OS_OPENAI_API_KEY=''
AI_OS_OPENAI_MAX_OUTPUT_TOKENS=1200
AI_OS_OPENROUTER_URL='https://openrouter.ai/api/v1'
AI_OS_OPENROUTER_API_KEY=''
AI_OS_OPENROUTER_MAX_COMPLETION_TOKENS=1200
AI_OS_ENABLE_AGENT_DAEMON=1
AI_OS_ENABLE_MARKET_CALENDAR_SCHEDULER=1
AI_OS_MARKET_CALENDAR_INTERVAL_SECONDS=21600
AI_OS_MARKET_CALENDAR_TIMEOUT_SECONDS=180
AI_OS_MARKET_CALENDAR_LOOKAHEAD_DAYS=45
AI_OS_ENABLE_RESEARCH_HUB_REFRESH=1
AI_OS_RESEARCH_HUB_REFRESH_INTERVAL_SECONDS=1800
AI_OS_RESEARCH_HUB_REFRESH_TIMEOUT_SECONDS=600
AI_OS_ENABLE_RESEARCH_HUB_VECTOR_REFRESH=1
AI_OS_RESEARCH_HUB_VECTOR_TIMEOUT_SECONDS=1800
# Native TradingView Desktop is user managed and is never a market-data daemon.
AI_OS_PLAYWRIGHT_BROWSERS_PATH='/Volumes/Devarsh SSD/AI OS Data/caches/playwright'
AI_OS_ALLOW_TOKENLESS_LOOPBACK=1
AI_OS_TIMESCALE_IMAGE='timescale/timescaledb@sha256:61f891691050da6032023c01ea885730eeeba06b7c17b403e7d0b9c49c37dfe9'
AI_OS_QDRANT_IMAGE='qdrant/qdrant@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c'
AI_OS_REDIS_IMAGE='redis@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99'
AI_OS_TAILSCALE_UI_PORT=443
AI_OS_TAILSCALE_API_PORT=8443
AI_OS_OFFSITE_BACKUP_ROOT='__HOME__/AI_OS_BACKUPS/critical'
