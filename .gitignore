_ai_os_runtime/run/
_ai_os_runtime/docker_data/
_ai_os_runtime/docker_data
_ai_os_runtime/browser_profiles/
_ai_os_runtime/obsidian_writeback/tmp/

# Runtime-generated analytical artifacts belong on the external SSD and in
# warehouse lineage. Previously tracked fixtures remain tracked, while new
# scheduler/backtest output stays out of the code repository.
_ai_os_runtime/artifacts/backtests/
_ai_os_runtime/artifacts/optimizations/
_ai_os_runtime/artifacts/strategy_discovery/
_ai_os_runtime/artifacts/user_defined_optimizer/
_ai_os_runtime/artifacts/research_papers/

# Raw imports can contain client statements and broker exports.
_ai_os_runtime/imports/quarantine/
_ai_os_runtime/imports/raw/
_ai_os_runtime/imports/**/*.xls
_ai_os_runtime/imports/**/*.xlsx
_ai_os_runtime/imports/**/*.csv
_ai_os_runtime/imports/**/*.pdf

# Generated recurring reports can contain client-private portfolio data.
# They remain in the external Obsidian vault and warehouse lineage, not Git.
ai memory/00 AI OS/Briefs/
ai memory/00 AI OS/Reports/Client Drafts/
ai memory/00 AI OS/Reports/Scheduled/
ai memory/02 Portfolio/Long-Term Monte Carlo/

# Build/dependency caches
_ai_os_runtime/ai-office-ui/node_modules
_ai_os_runtime/ai-office-ui/node_modules/
_ai_os_runtime/ai-office-ui/dist/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Vendored component internals that are reproducible or too large for GitHub.
_ai_os_runtime/external_components/**/.git/
_ai_os_runtime/external_components/**/node_modules/
_ai_os_runtime/external_components/FinceptTerminal/.qt/
_ai_os_runtime/external_components/FinceptTerminal/.aqt-venv/
